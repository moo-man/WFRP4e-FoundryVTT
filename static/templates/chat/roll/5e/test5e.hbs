<div class="test-title" data-tooltip="{{test.result.breakdown.formatted.test}}" data-tooltip-direction="LEFT">
    {{title}}
</div>

<div class="hide-option comparison">
    <span class="{{#if test.isCritical}}critical{{/if}} {{#if test.isFumble}}fumble{{/if}}">
        {{#if test.result.reversed}}
            {{test.result.originalRoll}}
            <i class="fa-solid fa-shuffle"></i>
        {{/if}}

        {{test.result.roll}}

    </span>
    <span>vs</span>
    <span>{{test.result.target}}</span>
</div>

<div class="sl">
    <div class="sl-container">
        {{test.result.displaySL}}
    </div>
</div>

<div class="description">
    <span>
        <strong>{{test.result.description}}</strong>

        {{#each test.result.tables}}
            - <a class="table-click action-link {{#if this.nulled}}nulled{{/if}} {{this.class}}" data-action="clickTable" data-column="{{this.column}}" style="{{this.style}}" data-table="{{this.key}}" data-modifier="{{this.modifier}}"><i class="fas fa-list"></i> {{this.label}}
                {{#if this.modifier}}({{numberFormat this.modifier sign=true}}){{/if}}</a>
        {{/each}}

        {{#if test.result.misfire}}
            - <a class="table-click  action-link fumble" data-action="clickTable" data-damage="{{test.result.misfireDamage}}" data-table="misfire"><i class="fas fa-list"></i> {{test.result.misfire}}</a>
        {{/if}}
    </span>
</div>

    
{{#if test.result.hitloc}}
<div>
    <strong>{{localize "ROLL.HitLocation"}}</strong>: {{test.result.hitloc.description}}
</div>
{{/if}}