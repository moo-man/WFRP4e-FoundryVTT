<section class="tab {{tab.cssClass}}" data-group="primary" data-tab="{{tab.id}}">

    <div class="channelling flexrow gap">
            {{#each actor.system.status.channelling.winds}}
            <div class="wind flexrow {{@key}} {{#if (eq ../actor.system.status.channelling.wind @key)}}current{{/if}}" data-wind="{{@key}}">
                <a data-action="rollTest" data-type="channelling">{{configLookup "magicWind" @key}}</a>
                <a class="value" data-action="stepChannelling">
                    {{#if (eq ../actor.system.status.channelling.wind @key)}}
                    {{../actor.system.status.channelling.value}}
                    {{else}}
                    0
                    {{/if}}
                </a>
            </div>
            {{/each}}
    </div>

    <div class="sheet-list petty">
        <div class="list-header row-content">
            <div class="list-name">{{localize "SHEET.PettySpell"}} <a class="sort-items" data-action="sortItems" data-tooltip="{{localize 'SHEET.SortItems'}}" data-type="cast"><i class="fas fa-sort-alpha-down"></i></a></div>
            <div class="list-controls">
                <a class="list-control" data-action="createItem" data-type="cast" data-category="petty">
                    <i class="fas fa-plus"></i>
                </a>
            </div>
        </div>
        <div class="list-content">
            {{#each items.spell.petty}}
                <div class="list-row" data-uuid="{{this.uuid}}">
                    <div class="row-content">
                        <div class="list-name rollable">
                            <img src="{{this.img}}" data-action="rollTest" data-type="cast">
                            <a class="label" data-action="toggleSummary">{{this.name}}</a>
                        </div>
                        <div class="list-controls">
                            <a class="list-control context-menu"><i class="fa-regular fa-ellipsis-vertical"></i></a>
                        </div>
                    </div>
                    {{> sheetButtons document=this}}
                    <div class="dropdown-content collapsed">

                    </div>
                </div>
            {{/each}}
        </div>
    </div>
    <div class="sheet-list spells">
        <div class="list-header row-content">
            <div class="list-name">{{localize "SHEET.LoreSpell"}} <a class="sort-items" data-action="sortItems" data-tooltip="{{localize 'SHEET.SortItems'}}" data-type="cast"><i class="fas fa-sort-alpha-down"></i></a></div>
            <div class="flex" data-tooltip="{{localize 'WFRP4E.TrappingType.Ingredients'}}" class="ingredients">{{localize "WFRP4E.TrappingType.Ingredients"}}</div>
            <div class="tiny" data-tooltip="{{localize 'SHEET.CN'}}">{{localize "CN"}}</div>
            <div class="tiny" data-tooltip="{{localize 'Memorized'}}">M</div>
            <div class="list-controls">
                <a class="list-control" data-action="createItem" data-type="cast">
                    <i class="fas fa-plus"></i>
                </a>
            </div>
        </div>
        <div class="list-content">
            {{#each items.spell.lore}}
                <div class="list-row" data-uuid="{{this.uuid}}">
                    <div class="row-content">
                        <div class="list-name rollable">
                            <img src="{{this.img}}" data-action="rollTest" data-type="cast">
                            <a class="label" data-action="toggleSummary">{{this.name}}</a>
                        </div>

                        <div class="flex">
                            <select data-action="editProperty" data-uuid="{{this.uuid}}" data-path="system.currentIng.value">
                            {{selectOptions this.system.ingredientList selected=this.system.currentIng.value labelAttr="name" valueAttr="id" blank=""}}
                            </select>
                        </div>

                        <div class="tiny">{{this.system.cn.value}}</div>


                        {{#if this.system.memorized.value}}
                        <a class="tiny" data-action="toggleProperty" data-path="system.memorized.value"><i class="far fa-check-circle"></i></a>
                        {{else}}
                        <a class="tiny" data-action="toggleProperty" data-path="system.memorized.value"><i class="far fa-circle"></i></a>
                        {{/if}}

                        <div class="list-controls">
                            <a class="list-control context-menu"><i class="fa-regular fa-ellipsis-vertical"></i></a>
                        </div>
                    </div>
                    {{#if this.system.cn.SL}}
                    <div class="progress-bar">
                        <div class="fill {{this.system.lore.value}}"  style="width:{{pct this.system.cn.SL this.system.cn.value}}%">
                        </div>
                    </div>
                    {{/if}}
                    {{#if (gt this.system.lore.value.length 1)}}
                    <div class="choose-lore">
                        {{#each this.system.lore.value}}
                            <a data-action="chooseLore" class="lore {{this}} {{#if (eq ../system.lore.chosen this)}}chosen{{/if}}" data-lore="{{this}}">
                                {{configLookup "magicLores" this}}
                            </a>
                        {{/each}}
                    </div>
                    {{/if}}
                    {{> sheetButtons document=this}}
                    <div class="dropdown-content collapsed">

                    </div>
                </div>
            {{/each}}
        </div>
    </div>
    {{> aspectsV2 aspectGroup=items.aspect.magic}}
</section>