<section class="tab {{tab.cssClass}}" data-group="primary" data-tab="{{tab.id}}">
    {{formGroup fields.specification.fields.value value=source.system.specification.value}}

    {{> spend fields=fields.spend.fields source=source.system.spend}}
    {{> testData fields=fields.test.fields source=system.test}}

    <fieldset>
        <legend>Attack</legend>
    {{formGroup fields.attack.fields.type value=source.system.attack.type}}
    {{#if system.attack.type}}
    {{formGroup fields.attack.fields.damage.fields.value value=source.system.attack.damage.value placeholder="#"}}
    {{formGroup fields.attack.fields.damage.fields.characteristic value=source.system.attack.damage.characteristic}}
    {{formGroup fields.attack.fields.damage.fields.SL value=source.system.attack.damage.SL}}
    {{formGroup fields.attack.fields.damage.fields.dice value=source.system.attack.damage.dice}}
    {{> itemProperties}}
    {{/if}}
    </fieldset>

</section>