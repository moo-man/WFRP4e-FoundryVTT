<div>
  <div class="form-group" {{#if tooltips.SL}}data-tooltip="{{tooltips.SL}}" data-tooltip-direction="LEFT"{{/if}}>
    <label>{{localize "SL"}}</label>
    <div class="form-fields">
      <input type="number" name="SL" value="{{fields.SL}}" />
    </div>
  </div>

    <div class="form-group stacked" {{#if tooltips.difficulty}}data-tooltip="{{tooltips.difficulty}}" data-tooltip-direction="LEFT" {{/if}}>
    <label>{{localize "Difficulty"}}</label>
    <div class="form-fields">
      <select name="difficulty">
        {{selectOptions (config "difficultyLabels") selected=fields.difficulty}}
      </select>
    </div>
  </div>

</div>